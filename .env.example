# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every variable is prefixed GO_AGENTS_ (see internal/config.EnvPrefix).

# development | staging | production
GO_AGENTS_ENV=development

# trace | debug | info | warn | error
GO_AGENTS_LOG_LEVEL=info
# json | console
GO_AGENTS_LOG_FORMAT=console

GO_AGENTS_HTTP_ADDR=:8080

# Bearer token guarding mutating API routes.
# REQUIRED when GO_AGENTS_ENV is not "development" — config.Load() fails
# rather than falling back to an unauthenticated service.
GO_AGENTS_API_TOKEN=

# Metrics and pprof listener. MUST differ from GO_AGENTS_HTTP_ADDR: collapsing
# the two would publish /debug/pprof on the port users reach, and config.Load()
# refuses that rather than serving heap dumps.
GO_AGENTS_ADMIN_ADDR=:9090

# Labels traces and the build_info metric.
GO_AGENTS_SERVICE_NAME=go-agents

# OTLP/HTTP collector host:port. Empty disables span export, which is what a
# plain `task run:server` on a laptop wants.
GO_AGENTS_OTLP_ENDPOINT=

# Head sampling ratio in [0,1]. 1 keeps every trace — right for the local kind
# cluster, wrong for production load.
GO_AGENTS_TRACE_SAMPLE_RATIO=1.0
