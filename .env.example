# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every variable is prefixed HERDR_AGENTISAN_ (see internal/config.EnvPrefix).

# development | staging | production
HERDR_AGENTISAN_ENV=development

# trace | debug | info | warn | error
HERDR_AGENTISAN_LOG_LEVEL=info
# json | console
HERDR_AGENTISAN_LOG_FORMAT=console

# Labels traces.
HERDR_AGENTISAN_SERVICE_NAME=herdr-agentisan

# OTLP/HTTP collector host:port. Empty disables span export, which is what a
# plain `task run:cli` on a laptop wants.
HERDR_AGENTISAN_OTLP_ENDPOINT=

# Head sampling ratio in [0,1]. 1 keeps every trace.
HERDR_AGENTISAN_TRACE_SAMPLE_RATIO=1.0
