# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every variable is prefixed GO_AGENTS_ (see internal/config.EnvPrefix).

# development | staging | production
GO_AGENTS_ENV=development

# trace | debug | info | warn | error
GO_AGENTS_LOG_LEVEL=info
# json | console
GO_AGENTS_LOG_FORMAT=console

# Labels traces.
GO_AGENTS_SERVICE_NAME=go-agents

# OTLP/HTTP collector host:port. Empty disables span export, which is what a
# plain `task run:cli` on a laptop wants.
GO_AGENTS_OTLP_ENDPOINT=

# Head sampling ratio in [0,1]. 1 keeps every trace.
GO_AGENTS_TRACE_SAMPLE_RATIO=1.0
