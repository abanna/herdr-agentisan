+    # the record comes before the split, so a lost split reply still leaves one: status and abort say what to do
+    printf 'old=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\nold_terminal=%s\nlaunched_at=%s\nsession=%s\nmodel_pid=0\nmodel_start=0\n' \
+      "$old" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" "$oldterm" "$(date +%s%3N)" "$session" > "$dir/state"
+    split=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO") || die "the split failed; it may still have made a pane (run: shift.sh status)"
