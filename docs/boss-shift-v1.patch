--- shift.sh
+++ shift.sh
@@ -18,0 +19,2 @@
+# The candidate starts with its own --session-id. brief pins that Claude once and proves its model with the
+# plugin's `boss shift check-model`; go and takeover prove the same process again. Nothing waits for a report.
@@ -29,0 +32 @@
+PLUGIN=${SHIFT_PLUGIN:-herdr-agentisan}
@@ -42,2 +45,23 @@
-# model_ok <reported> <wanted>: an alias ("fable") matches a full id ("claude-fable-5-2").
-model_ok(){ case "$(printf %s "$1" | tr '[:upper:]' '[:lower:]')" in *"$(printf %s "$2" | tr '[:upper:]' '[:lower:]')"*) return 0 ;; esac; return 1; }
+# check_model: names the candidate Claude (no pin saved) or proves that pinned process and its model.
+check_model(){
+    "$PLUGIN" boss shift check-model --pane "$(val new)" --terminal "$(val terminal)" --name "$(val next)" \
+        --model "$(val model)" --launched-at "$(val launched_at)" --session-id "$(val session)" \
+        --pid "$(val model_pid)" --start "$(val model_start)"
+}
+pinned(){ [[ "$(val model_pid)" =~ ^[1-9][0-9]*$ ]]; }
+# pin_model: only brief calls it, only while nothing is pinned.
+pin_model(){
+    local v pid start tmp
+    v=$(check_model) || { printf '%s\n' "$v"; return 1; }
+    pid=$(field pid <<< "$v") && start=$(field start <<< "$v") && [[ "$pid" =~ ^[1-9][0-9]*$ && "$start" =~ ^[1-9][0-9]*$ ]] || return 1
+    tmp=$(mktemp "$CUR/state.XXXXXXXX") &&
+      { cat "$CUR/state"; printf 'model_pid=%s\nmodel_start=%s\n' "$pid" "$start"; } > "$tmp" && mv "$tmp" "$CUR/state" || { rm -f "$tmp"; return 1; }
+}
+# own_shift: a command that changes a shift stays with the folder it starts in and holds its lock, never over a
+# human wait. live: nothing replaced or aborted that shift; check it before each action that touches a pane.
+own_shift(){ need_cur; CUR=$(readlink "$CUR"); exec 9>"$CUR/lock"; flock -w 30 9 || die "the shift is busy; try again"; }
+ended(){ [ "$(readlink "$ROOT/current")" != "${1:-$CUR}" ] || [ -e "${1:-$CUR}/ABORTED" ]; }
+live(){ ! ended || die "the shift changed or was aborted; nothing was done"; }
+candidate_ready(){ pinned || { echo "shift: no candidate process pin; run shift.sh brief, or abort and open again" >&2; return 1; }; check_model; }
+holds(){ [ -n "$2" ] && [ "$({ herdr pane get "$1" 2>/dev/null | field result.pane.terminal_id 2>/dev/null; } || true)" = "$2" ]; }
+close_checked(){ holds "$@" && herdr pane close "$1" >/dev/null; }
