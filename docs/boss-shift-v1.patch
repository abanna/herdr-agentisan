+    dir=$(readlink "$CUR")
+    [ ! -e "$dir/GO-CUED" ] || die "GO already recorded and candidate cued; inspect status"
+    candidate_ready "$dir" || die "GO cue withheld; fix model proof or inspect status"
+    if [ ! -e "$dir/GO" ]; then
+      date +%H:%M:%S > "$dir/GO.tmp"
+      mv "$dir/GO.tmp" "$dir/GO"
@@ -92,2 +138,3 @@
-    date +%H:%M:%S > "$CUR/GO"
-    herdr agent prompt "$(val next)" "From the outgoing boss: GO. You have the picture. Run: $here/shift.sh takeover" >/dev/null
+    herdr agent prompt "$(val next)" "From the outgoing boss: GO. You have the picture. Run: $here/shift.sh takeover" >/dev/null ||
+      die "GO is recorded but the candidate cue failed; rerun shift.sh go to cue the candidate"
+    touch "$dir/GO-CUED"
@@ -104,0 +152 @@
