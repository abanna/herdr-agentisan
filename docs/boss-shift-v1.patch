+    if ! candidate_ready; then
+      touch "$CUR/MODEL-BLOCKED"
+      die "GO withheld; fix model proof and publish a fresh account and reply"
@@ -92 +116,4 @@
-    date +%H:%M:%S > "$CUR/GO"
