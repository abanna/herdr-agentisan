--- shift.sh
+++ shift.sh
@@ -18,0 +19,3 @@
+# After recording the split, open allows up to 290 s for startup and model checks.
+# Use a shell timeout of at least 300 s. If interrupted, check status for the saved pin.
+# If pinned, continue the handoff and go rechecks it. Otherwise abort and open again.
@@ -29,0 +33 @@
+PLUGIN=${SHIFT_PLUGIN:-herdr-agentisan}
@@ -38,6 +42,25 @@
-val(){ sed -n "s/^$1=//p" "$CUR/state" | tail -1; }
-# model_of <agent>: the model that agent's own statusline reports on its pane
-# (the plugin's `model` token, ADR-001 A56); empty when it has reported none.
-model_of(){ { herdr agent get "$1" 2>/dev/null | field result.agent.tokens.model 2>/dev/null; } || true; }
-# model_ok <reported> <wanted>: an alias ("fable") matches a full id ("claude-fable-5-2").
-model_ok(){ case "$(printf %s "$1" | tr '[:upper:]' '[:lower:]')" in *"$(printf %s "$2" | tr '[:upper:]' '[:lower:]')"*) return 0 ;; esac; return 1; }
+val(){ sed -n "s/^$1=//p" "${2:-$CUR}/state" | tail -1; }
+open_call(){ local left=$((deadline-SECONDS)); ((left>0)) && timeout -k 1 "$left" "$@"; }
+check_model(){
+    local pid start pinned_at
+    pid=$(val model_pid "$1"); start=$(val model_start "$1"); pinned_at=$(val model_pinned_at "$1")
+    "${@:2}" "$PLUGIN" boss shift check-model --pane "$(val new "$1")" --terminal "$(val terminal "$1")" \
+        --name "$(val next "$1")" --model "$(val model "$1")" --launched-at "$(val launched_at "$1")" \
+        --pid "${pid:-0}" --start "${start:-0}" --pinned-at "${pinned_at:-0}"
+}
+candidate_ready(){
+    if ! [[ "$(val model_pid "$1")" =~ ^[1-9][0-9]*$ && "$(val model_pinned_at "$1")" =~ ^[1-9][0-9]*$ ]]; then
+      echo "shift: no candidate process pin; abort and open again" >&2
+      return 1
+    fi
+    check_model "$1"
+}
+pin_model() (
+    local pid start pinned_at file
+    pid=$(field pid <<< "$2") && start=$(field start <<< "$2") || exit 1
+    [[ "$pid" =~ ^[1-9][0-9]*$ && "$start" =~ ^[1-9][0-9]*$ ]] || exit 1
+    pinned_at=$(date +%s%3N) && file=$(mktemp "$1/state.XXXXXXXX") || exit 1
+    trap 'rm -f -- "$file"' EXIT
+    { cat "$1/state" && printf 'model_pid=%s\nmodel_start=%s\nmodel_pinned_at=%s\n' "$pid" "$start" "$pinned_at"; } > "$file" &&
+      mv "$file" "$1/state"
+)
@@ -47,0 +71,2 @@
+    deadline=${SHIFT_OPEN_DEADLINE:-290}
+    [[ "$deadline" =~ ^[1-9][0-9]{0,2}$ ]] && ((deadline<=290)) || die "open deadline must be 1 to 290 seconds"
@@ -49,0 +75 @@
+    echo "shift: allow up to $deadline s for startup and model checks after the split is recorded. Please run this with a shell timeout of at least $((deadline+10)) s." >&2
@@ -52,2 +78,7 @@
-    dir=$ROOT/$(date +%Y%m%d-%H%M%S); mkdir -p "$dir"
-    new=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO" | field result.pane.pane_id)
+    help=$("$PLUGIN" boss shift check-model --help 2>/dev/null) && [[ "$help" == *"--pinned-at"* ]] ||
+      die "install a herdr-agentisan build with boss shift check-model, or set SHIFT_PLUGIN to its path"
+    mkdir -p "$ROOT"
+    dir=$(mktemp -d "$ROOT/$(date +%Y%m%d-%H%M%S)-XXXXXXXX")
+    split=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO")
+    new=$(field result.pane.pane_id <<< "$split")
+    terminal=$(field result.pane.terminal_id <<< "$split")
@@ -55 +86,7 @@
-    printf 'old=%s\nnew=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\n' "$old" "$new" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" > "$dir/state"
+    if [ -z "$terminal" ]; then
+      [ "$new" != "$old" ] || die "the split returned the outgoing pane"
+      herdr pane close "$new" >/dev/null || die "no terminal id; could not close candidate pane $new"
+      die "the split returned no terminal id; closed candidate pane $new"
+    fi
+    launched_at=$(date +%s%3N)
+    printf 'old=%s\nnew=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\nterminal=%s\nlaunched_at=%s\nmodel_pid=0\nmodel_start=0\nmodel_pinned_at=0\n' "$old" "$new" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" "$terminal" "$launched_at" > "$dir/state"
@@ -56,0 +94 @@
+    SECONDS=0
@@ -58 +96 @@
-    herdr agent start "$NEXT" --kind claude --pane "$new" --timeout 90000 -- --name "$NEXT" --model "$MODEL" --effort "$EFFORT" >/dev/null \
+    open_call herdr agent start "$NEXT" --kind claude --pane "$new" --timeout 90000 -- --name "$NEXT" --model "$MODEL" --effort "$EFFORT" >/dev/null \
@@ -60,6 +98,25 @@
-    # what it was asked for is not what it runs: read the model back from its pane
-    got=; for _ in $(seq 1 30); do got=$(model_of "$NEXT"); [ -n "$got" ] && break; sleep 2; done
-    if [ -z "$got" ]; then
-      echo "warning: $NEXT has reported no model yet (asked for $MODEL); 'shift.sh go' checks again and refuses a wrong one"
-    elif ! model_ok "$got" "$MODEL"; then
-      die "the incoming boss runs on '$got', not '$MODEL' (pane $new left open; run: shift.sh abort, then open again)"
+    pinned=0
+    while ((SECONDS<deadline)); do
+      rc=0; verdict=$(check_model "$dir" open_call 2>/dev/null) || rc=$?
+      ((SECONDS<deadline)) || break
+      if [ "$rc" = 0 ]; then
+        printf '%s\n' "$verdict"
+        echo "opened: incoming boss $NEXT on $new; shift folder $dir"
+        exit 0
+      fi
+      reason=$(field reason <<< "$verdict" 2>/dev/null) || reason=
+      if [ "$pinned" = 0 ] && [ -n "$reason" ] && pin_model "$dir" "$verdict"; then pinned=1; fi
+      case "$reason" in
+        ""|candidate_unavailable|claude_unavailable|missing_model|invalid_report_time|stale_report|awaiting_pin|report_before_pin)
+          left=$((deadline-SECONDS))
+          ((left<=0)) || sleep "$((left<2 ? left : 2))" ;;
+        *) break ;;
+      esac
+    done
+    if ((SECONDS<deadline)); then
+      printf '%s\n' "$verdict"
+      case "$reason" in
+        candidate_changed) die "the candidate changed; abort and open again" ;;
+        wrong_model) die "select the requested model with /model in the candidate pane, or abort and open again" ;;
+        *) die "model check refused; run shift.sh status" ;;
+      esac
@@ -67 +124,2 @@
