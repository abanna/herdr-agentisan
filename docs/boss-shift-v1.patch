-    dir=$ROOT/$(date +%Y%m%d-%H%M%S); mkdir -p "$dir"
-    new=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO" | field result.pane.pane_id)
-    [ -n "$new" ] || die "the split returned no pane id"
-    printf 'old=%s\nnew=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\n' "$old" "$new" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" > "$dir/state"
+    mkdir -p "$ROOT"
+    dir=$(mktemp -d "$ROOT/$(date +%Y%m%d-%H%M%S)-XXXXXXXX")
+    split=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO")
+    new=$(field result.pane.pane_id <<< "$split")
+    terminal=$(field result.pane.terminal_id <<< "$split")
+    [ -n "$new" ] && [ -n "$terminal" ] || die "the split returned no pane or terminal id"
+    launched_at=$(date +%s%3N)
+    printf 'old=%s\nnew=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\nterminal=%s\nlaunched_at=%s\nmodel_pid=0\nmodel_start=0\n' "$old" "$new" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" "$terminal" "$launched_at" > "$dir/state"
@@ -60,8 +72,22 @@
-    # what it was asked for is not what it runs: read the model back from its pane
-    got=; for _ in $(seq 1 30); do got=$(model_of "$NEXT"); [ -n "$got" ] && break; sleep 2; done
-    if [ -z "$got" ]; then
-      echo "warning: $NEXT has reported no model yet (asked for $MODEL); 'shift.sh go' checks again and refuses a wrong one"
-    elif ! model_ok "$got" "$MODEL"; then
-      die "the incoming boss runs on '$got', not '$MODEL' (pane $new left open; run: shift.sh abort, then open again)"
-    fi
-    echo "opened: incoming boss $NEXT on $new, model ${got:-not reported yet}; shift folder $dir" ;;
+    for ((i=0; i<30; i++)); do
+      verified=0
+      verdict=$(check_model) && verified=1
+      if [ "$(val model_pid)" = 0 ]; then
+        pid=$(field pid <<< "$verdict")
+        start=$(field start <<< "$verdict")
+        if [ "${pid:-0}" != 0 ] && [ "${start:-0}" != 0 ]; then
+          printf 'model_pid=%s\nmodel_start=%s\n' "$pid" "$start" >> "$dir/state"
+        fi
+      fi
+      if [ "$verified" = 1 ]; then
+        printf '%s\n' "$verdict"
+        echo "opened: incoming boss $NEXT on $new; shift folder $dir"
+        exit 0
+      fi
+      case $(field reason <<< "$verdict") in
+        candidate_unavailable|claude_unavailable|missing_model|invalid_report_time|stale_report) sleep 2 ;;
+        *) break ;;
+      esac
+    done
+    printf '%s\n' "$verdict"
+    die "the candidate's model is unverified; inspect status, fix the report or abort" ;;
