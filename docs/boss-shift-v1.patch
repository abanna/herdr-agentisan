--- shift.sh
+++ shift.sh
@@ -18,0 +19,3 @@
+# open starts the candidate with its own --session-id. brief pins the Claude that runs it, once, with
+# the plugin's `boss shift check-model`; go and takeover prove that same process reports the model
+# asked for. Nothing here waits for a report: when go is refused, fix the cause and run it again.
@@ -29,0 +33 @@
+PLUGIN=${SHIFT_PLUGIN:-herdr-agentisan}
@@ -41,0 +46,22 @@
+# check_model: the plugin's proof about the candidate Claude launched with this shift's --session-id.
+# With no pin saved it names that Claude; with one it proves the same process reports the model.
+check_model(){
+    "$PLUGIN" boss shift check-model --pane "$(val new)" --terminal "$(val terminal)" --name "$(val next)" \
+        --model "$(val model)" --launched-at "$(val launched_at)" --session-id "$(val session)" \
+        --pid "$(val model_pid)" --start "$(val model_start)"
+}
+pinned(){ [[ "$(val model_pid)" =~ ^[1-9][0-9]*$ ]]; }
+# pin_model: only brief calls it, only while nothing is pinned. A pin is never replaced.
+pin_model(){
+    local v pid start tmp
+    v=$(check_model) || { printf '%s\n' "$v"; return 1; }
+    pid=$(field pid <<< "$v") && start=$(field start <<< "$v") && [[ "$pid" =~ ^[1-9][0-9]*$ && "$start" =~ ^[1-9][0-9]*$ ]] || return 1
+    tmp=$(mktemp "$CUR/state.XXXXXXXX") &&
+      { cat "$CUR/state"; printf 'model_pid=%s\nmodel_start=%s\n' "$pid" "$start"; } > "$tmp" && mv "$tmp" "$CUR/state" || { rm -f "$tmp"; return 1; }
+}
+candidate_ready(){ pinned || { echo "shift: no candidate process pin; run shift.sh brief, or abort and open again" >&2; return 1; }; check_model; }
+# close_checked <pane> <terminal>: close the pane only while it still holds that terminal.
+close_checked(){
+    [ -n "$2" ] && [ "$({ herdr pane get "$1" 2>/dev/null | field result.pane.terminal_id 2>/dev/null; } || true)" = "$2" ] &&
+      herdr pane close "$1" >/dev/null
+}
