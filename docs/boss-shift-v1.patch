-    [ "$who" = "$old" ] || die "agent $BOSS is on pane '$who', and I am on '$old': refusing"
+    help=$("$PLUGIN" boss shift check-model --help 2>/dev/null) && [[ "$help" == *"--session-id"* ]] ||
+      die "install a herdr-agentisan build with boss shift check-model, or set SHIFT_PLUGIN to its path"
+    me=$(herdr agent get "$BOSS"); who=$(field result.agent.pane_id <<< "$me"); oldterm=$(field result.agent.terminal_id <<< "$me")
+    [ "$who" = "$old" ] && [ -n "$oldterm" ] || die "agent $BOSS is on pane '$who' (terminal '$oldterm'), and I am on '$old': refusing"
@@ -53,4 +76,10 @@
-    new=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO" | field result.pane.pane_id)
-    [ -n "$new" ] || die "the split returned no pane id"
-    printf 'old=%s\nnew=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\n' "$old" "$new" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" > "$dir/state"
-    ln -s "$dir" "$CUR"
+    session=$(python3 -c 'import uuid;print(uuid.uuid4())')
+    ln -sn "$dir" "$CUR" || die "another open took the shift ($(readlink "$CUR")); nothing written"
+    # the record comes before the split, so a lost split reply still leaves one: status and abort say what to do
+    printf 'old=%s\nboss=%s\nnext=%s\nopened=%s\nmodel=%s\neffort=%s\nold_terminal=%s\nlaunched_at=%s\nsession=%s\nmodel_pid=0\nmodel_start=0\n' \
+      "$old" "$BOSS" "$NEXT" "$(date +%H:%M:%S)" "$MODEL" "$EFFORT" "$oldterm" "$(date +%s%3N)" "$session" > "$dir/state"
+    split=$(herdr pane split "$old" --direction right --no-focus --cwd "$REPO") || die "the split failed; it may still have made a pane (run: shift.sh status)"
+    new=$(field result.pane.pane_id <<< "$split" 2>/dev/null || true); terminal=$(field result.pane.terminal_id <<< "$split" 2>/dev/null || true)
+    printf 'new=%s\nterminal=%s\n' "$new" "$terminal" >> "$dir/state"
+    [ -n "$new" ] && [ -n "$terminal" ] || die "the split returned no pane or terminal id: close the new pane (${new:-unknown}) by hand, then run: shift.sh abort"
+    [ "$(readlink "$CUR")" = "$dir" ] || { close_checked "$new" "$terminal"; die "the shift ended during the split; closed the new pane $new if it was the candidate's"; }
@@ -58 +87 @@
-    herdr agent start "$NEXT" --kind claude --pane "$new" --timeout 90000 -- --name "$NEXT" --model "$MODEL" --effort "$EFFORT" >/dev/null \
+    herdr agent start "$NEXT" --kind claude --pane "$new" --timeout 90000 -- --name "$NEXT" --model "$MODEL" --effort "$EFFORT" --session-id "$session" >/dev/null \
@@ -60,8 +89 @@
-    # what it was asked for is not what it runs: read the model back from its pane
-    got=; for _ in $(seq 1 30); do got=$(model_of "$NEXT"); [ -n "$got" ] && break; sleep 2; done
-    if [ -z "$got" ]; then
-      echo "warning: $NEXT has reported no model yet (asked for $MODEL); 'shift.sh go' checks again and refuses a wrong one"
-    elif ! model_ok "$got" "$MODEL"; then
-      die "the incoming boss runs on '$got', not '$MODEL' (pane $new left open; run: shift.sh abort, then open again)"
-    fi
-    echo "opened: incoming boss $NEXT on $new, model ${got:-not reported yet}; shift folder $dir" ;;
+    echo "opened: incoming boss $NEXT on $new; shift folder $dir. Next: shift.sh brief, which proves its model" ;;
@@ -69,0 +92,2 @@
+    pinned || pin_model || die "the candidate Claude is not identified, so nothing was sent: wait for it to start and run brief again, or abort"
+    candidate_ready || die "the candidate's model is not proved, so nothing was sent: run brief again once it has reported, or abort"
@@ -85,9 +109,6 @@
-    # no GO to a boss on the wrong model: the team is not handed to it
-    want=$(val model); want=${want:-$MODEL}; got=$(model_of "$(val next)")
-    if [ -z "$got" ]; then
-      [ -n "${SHIFT_MODEL_SEEN:-}" ] || die "the incoming boss's pane reports no model, so I cannot check it is on '$want'. Look yourself ('herdr agent read $(val next)' shows the model under its prompt); if it is right, run: SHIFT_MODEL_SEEN=1 shift.sh go. GO not written."
-    elif ! model_ok "$got" "$want"; then
-      die "the incoming boss runs on '$got'; the boss must run on '$want'. Ask the user to switch it with /model in pane $(val new), or abort and open again. GO not written."
-    fi
-    date +%H:%M:%S > "$CUR/GO"
-    herdr agent prompt "$(val next)" "From the outgoing boss: GO. You have the picture. Run: $here/shift.sh takeover" >/dev/null
+    [ ! -e "$CUR/GO-CUED" ] || die "GO is already recorded and the candidate cued (run: shift.sh status)"
+    candidate_ready || die "the candidate is not verified; nothing was sent"
+    [ -e "$CUR/GO" ] || { date +%H:%M:%S > "$CUR/GO.tmp" && mv "$CUR/GO.tmp" "$CUR/GO"; }
+    herdr agent prompt "$(val next)" "From the outgoing boss: GO. You have the picture. Run: $here/shift.sh takeover" >/dev/null ||
+      die "GO is recorded but the cue failed: run shift.sh go again"
+    touch "$CUR/GO-CUED"
@@ -98 +119,3 @@
-    herdr pane close "$(val new)" >/dev/null 2>&1 || true
+    if [ -z "$(val new)" ]; then echo "shift: no pane was recorded; if the split made one, close it by hand (herdr pane list)" >&2
+    elif close_checked "$(val new)" "$(val terminal)"; then echo "closed candidate pane $(val new)"
+    else echo "shift: pane $(val new) is not confirmed as the candidate's terminal; not closed. Look (herdr pane list) before closing anything" >&2; fi
@@ -100 +123 @@
-    echo "aborted: incoming pane closed; the outgoing boss stays in charge. Tell the user." ;;
+    echo "aborted: the outgoing boss stays in charge. Tell the user." ;;
@@ -104,0 +128 @@
+    candidate_ready || die "candidate model unverified; old pane left open"
@@ -106 +130 @@
-    herdr pane close "$old" >/dev/null || die "could not close the old pane $old; nothing renamed"
+    close_checked "$old" "$(val old_terminal)" || die "the old pane $old is not the recorded terminal, or did not close; nothing renamed"
@@ -114 +138,4 @@
-    if [ -L "$CUR" ]; then cat "$CUR/state"; echo "reported_model=$(model_of "$(val next)")"; ls "$CUR"; else echo "no shift open"; fi ;;
+    if [ -L "$CUR" ]; then cat "$CUR/state"; ls "$CUR"
+      if [ -n "$(val new)" ]; then check_model || true
+      else echo "no candidate pane was recorded: the split may have made one. Look (herdr pane list), close it by hand, then run: shift.sh abort"; fi
+    else echo "no shift open"; fi ;;
