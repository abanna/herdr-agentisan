+      die "the body must be UTF-8 text, not blank, at most 120 KiB; nothing written"
+    { printf 'attempt: %s\nround: %s\n\n' "${dir##*/}" "$n"; cat "$bodyf"; printf '\n<!-- end shift round -->\n'; } > "$tmp" || die "the account could not be written"
+    CUR=$dir; exec 9>"$CUR/lock"; flock -w 30 9 || die "the shift is busy; try again"
+    live
+    [ ! -e "$CUR/GO" ] || die "GO is recorded; the account is final (abort and open again to change it)"
+    [ "$(aval state)" != withdrawn ] || die "the approval was withdrawn: abort and open again"
+    mv -T "$tmp" "$CUR/account-$n.md" || die "the account could not be written"
+    echo "account $n written" ;;
   say)
     own_shift; live; [ $# -ge 1 ] || die "say what?"
