     live
-    text="You are the INCOMING boss of the herdr-agentisan team, starting a shift change. The outgoing boss is still in charge in the pane beside you. Read $role now and follow its Candidate section exactly. Your attempt directory is $CUR and its attempt ID is ${CUR##*/}. Do not message workers, do not run 'herdr-agentisan board read', and never type into the other pane."
+    text="You are the INCOMING boss of the herdr-agentisan team, starting a shift change. The outgoing boss is still in charge in the pane beside you. Read $role_copy now and follow its Candidate section exactly. Your attempt directory is $CUR and its attempt ID is ${CUR##*/}. Do not message workers, do not run 'herdr-agentisan board read', and never type into the other pane."
+    # A failed prompt response can still leave a delivered cue, so keep its copy from here on.
+    trap - EXIT
     herdr agent prompt "$(val next)" "$text" >/dev/null && echo "briefed $(val next)" ;;
   wait)
