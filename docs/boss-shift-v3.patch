+    [ "${HERDR_PANE_ID:-}" = "$(val new)" ] || die "only the incoming boss (pane $(val new)) writes an account"
+    [ ! -t 0 ] || die "the body goes on stdin"
+    tmp=$(mktemp "$dir/account.XXXXXXXX"); bodyf=$(mktemp "$dir/account.XXXXXXXX"); trap 'rm -f "$tmp" "$bodyf"' EXIT
+    head -c 122881 > "$bodyf"
