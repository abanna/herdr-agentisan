+    [ ! -e "$CUR/GO" ] || die "GO is recorded; the approval cannot change (withdraw, or abort and open again)"
+    [ "$(aval state)" != withdrawn ] || die "the approval was withdrawn for good: abort and open again"
+    got=$("$PLUGIN" boss shift wait --record "$CUR" --attempt "${CUR##*/}" --round "$n" --timeout 0) && [ "$(field sha256 <<< "$got")" = "$sha" ] ||
+      die "round $n's account is not the one you read (digest $sha), or there is none; nothing recorded: review it again"
+    for k in 1 2 3; do [ "$k" -le "$n" ] || [ ! -e "$CUR/account-$k.md" ] || die "a later round exists; approve the newest account"; done
+    record approved "$n" "$sha"; echo "approved round $n ($sha)" ;;
+  withdraw)
+    own_shift; live
+    [ "${HERDR_PANE_ID:-}" = "$(val old)" ] || die "only the outgoing boss (pane $(val old)) withdraws"
+    record withdrawn "$(aval round)" "$(aval account)"; echo "approval withdrawn for good: abort and open again" ;;
+  account)
+    # account N (the incoming boss), the body on stdin. It is published under the shift lock, so it never lands while
+    # takeover runs; the body is read and checked before the lock, so a stalled writer never holds up takeover or abort.
+    need_cur; dir=$(readlink "$CUR"); n=${1:-}
