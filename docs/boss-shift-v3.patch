--- shift.sh
+++ shift.sh
@@ -13,5 +13,8 @@
 #                   shift.sh wait [N]        wait 2 minutes for account-N.md (default: the account awaiting a reply); run it again on a timeout
 #                   shift.sh say "<text>"    tell the incoming boss something (typed into ITS pane)
-#                   shift.sh go              write GO: the incoming boss may take over
+#                   shift.sh approve N SHA   approve round N's account, the digest wait printed with the text I read
+#                   shift.sh account N       (incoming boss) publish round N's account, the body on stdin, under the lock
+#                   shift.sh withdraw        withdraw the approval for good (even after GO): abort and open again
+#                   shift.sh go              write GO once the newest account is approved
 #                   shift.sh abort "<why>"   close the incoming pane; I stay in charge
 #   incoming boss:  shift.sh takeover        after GO: close the old pane, take the name
@@ -65,4 +68,17 @@
 live(){ ! ended || die "the shift changed or was aborted; nothing was done"; }
 candidate_ready(){ pinned || { echo "shift: no candidate process pin; run shift.sh brief, or abort and open again" >&2; return 1; }; check_model; }
+# The approval is ONE record, `approval`, written only by approve and withdraw under the shift lock. approval_ok proves it
+# against the files as they are now: approved, account N valid with the recorded digest, no later round.
+aval(){ { sed -n "s/^$1: //p" "$CUR/approval" 2>/dev/null | tail -1; } || true; }
+approval_ok(){
+    local r=$(aval round) got k
+    [ "$(aval state)" = approved ] && [[ "$r" =~ ^[1-3]$ ]] || return 1
+    got=$("$PLUGIN" boss shift wait --record "$CUR" --attempt "${CUR##*/}" --round "$r" --timeout 0) && [ "$(field sha256 <<< "$got")" = "$(aval account)" ] || return 1
+    for k in 1 2 3; do [ "$k" -le "$r" ] || [ ! -e "$CUR/account-$k.md" ] || return 1; done
+}
+record(){
+    local t; t=$(mktemp "$CUR/approval.XXXXXXXX") && printf 'state: %s\nround: %s\naccount: %s\nat: %s\n' "$1" "$2" "$3" "$(date +%H:%M:%S)" > "$t" &&
+      mv -T "$t" "$CUR/approval" || { rm -f "$t"; die "the approval record could not be written"; }
+}
 holds(){ [ -n "$2" ] && [ "$({ herdr pane get "$1" 2>/dev/null | field result.pane.terminal_id 2>/dev/null; } || true)" = "$2" ]; }
 close_checked(){ holds "$@" && herdr pane close "$1" >/dev/null; }
