     "$PLUGIN" boss shift wait --record "$dir" --attempt "${dir##*/}" ${1:+--round "$1"} --timeout 2m ;;
+  approve)
+    own_shift; live
+    [ "${HERDR_PANE_ID:-}" = "$(val old)" ] || die "only the outgoing boss (pane $(val old)) approves"
+    n=${1:-}; sha=${2:-}
