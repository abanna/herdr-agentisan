# Normalize line endings so a CRLF checkout cannot produce a spurious diff.
* text=auto eol=lf

# Binary types. Declared so git never tries to merge or line-diff them, and
# so a reviewer sees "Bin" rather than a wall of mojibake. Committing any of
# these is separately gated by `devctl large-files`.
*.bin   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.woff  binary
*.woff2 binary
